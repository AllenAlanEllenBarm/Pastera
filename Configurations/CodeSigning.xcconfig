CODE_SIGN_IDENTITY[config=Debug] = Mac Developer
CODE_SIGN_IDENTITY[config=Release] = Developer ID Application
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM = BBCHAJ584H
PROVISIONING_PROFILE_SPECIFIER[config=Debug] = ClipyDevelopment
PROVISIONING_PROFILE_SPECIFIER[config=Release] =
ENABLE_HARDENED_RUNTIME[config=Release] = YES
OTHER_CODE_SIGN_FLAGS[config=Release] = --timestamp
CODE_SIGN_ENTITLEMENTS[config=Release] = pastera/Pastera.entitlements

#include "Configurations/CodeSigning-AdHoc.xcconfig"
