          }
        }
      }
    },
    "Secure Keyboard Entry is active. macOS may block global shortcuts; click this menu bar icon to open Pastera." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全键盘输入已启用。macOS 可能会阻止全局快捷键；点击这个菜单栏图标可打开 Pastera。"
          }
        }
      }
    },
    "macOS paused global shortcuts while Secure Keyboard Entry is active. Click the Pastera menu bar icon to open Pastera." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "macOS hat globale Tastenkürzel angehalten, solange die sichere Tastatureingabe aktiv ist. Klicke auf das Pastera-Symbol in der Menüleiste, um Pastera zu öffnen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "macOS paused global shortcuts while Secure Keyboard Entry is active. Click the Pastera menu bar icon to open Pastera." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "macOS ha sospeso le scorciatoie globali mentre l'inserimento sicuro da tastiera è attivo. Fai clic sull'icona Pastera nella barra dei menu per aprire Pastera." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "セキュアキーボード入力が有効なため、macOSがグローバルショートカットを一時停止しました。メニューバーのPasteraアイコンをクリックして開いてください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安全键盘输入启用期间，macOS 已暂停全局快捷键。请点击菜单栏中的 Pastera 图标打开 Pastera。" } }
      }
    },
